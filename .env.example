# Cadeia ordenada de provedores: tenta na ordem e usa o primeiro que responder.
# Custo zero primeiro (Ollama local, depois Groq grátis); o DeepSeek (pago) só entra por último.
LLM_PROVIDERS=ollama,groq,deepseek
# Alternativa antiga, usada só se LLM_PROVIDERS não existir:
# LLM_PROVIDER=ollama
# FALLBACK_PROVIDER=groq
LLM_TIMEOUT=3.0
# Timeout dos provedores de contingência (Groq, DeepSeek). Modelos de raciocínio com evidência longa
# podem passar de 10 s: 30 é um valor seguro.
# FALLBACK_TIMEOUT=30
# Quanto o roteador espera o juiz. Padrão calculado: JUDGE_LLM_TIMEOUT + FALLBACK_TIMEOUT por provedor
# de contingência + 15 s. Só defina à mão se precisar.
# JUDGE_SERVICE_TIMEOUT=

# Disjuntor: depois de N falhas seguidas o provedor é pulado por alguns segundos, sem esperar o timeout.
LLM_BREAKER_FAILURES=3
LLM_BREAKER_COOLDOWN=120
# Teto diário de chamadas por provedor (dia UTC). Padrão: só o DeepSeek, com 200. 0 desliga o teto.
DEEPSEEK_DAILY_CAP=200

# Ollama Local (macOS)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Provedor em Nuvem - Groq (Contingência)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Modelo por papel (opcional): a Groq limita o uso POR MODELO, então modelos diferentes para o roteador
# e o juiz dão cotas separadas. Vale para GROQ, DEEPSEEK e OPENAI: <PAPEL>_<PROVEDOR>_MODEL.
# ROUTER_GROQ_MODEL=openai/gpt-oss-20b
# JUDGE_GROQ_MODEL=openai/gpt-oss-120b

# DeepSeek (pago, último da cadeia). A chave fica só no .env da VM, nunca no Git.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# OpenAI (Opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama exposto por túnel (Azure -> máquina local): chave do proxy (Caddy) que exige Bearer.
# Vazia em desenvolvimento local. Em produção vai num Secret do Kubernetes, nunca no Git.
OLLAMA_API_KEY=
