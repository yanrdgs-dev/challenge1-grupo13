# Provedor principal e contingência
LLM_PROVIDER=ollama
FALLBACK_PROVIDER=groq
LLM_TIMEOUT=3.0

# Ollama Local (macOS)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Provedor em Nuvem - Groq (Contingência)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI (Opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
