# Imagem base oficial Python slim
FROM python:3.11-slim

WORKDIR /app

# Instala ferramentas essenciais do sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Instala o uv (package manager) a partir da imagem oficial
COPY --from=ghcr.io/astral-sh/uv:0.12.15 /uv /uvx /bin/

# Instala dependências do projeto (somente produção, versões do uv.lock)
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-dev --no-install-project
ENV PATH="/app/.venv/bin:$PATH"

# Copia o código-fonte e os scripts. Os parquets vêm de volume montado em /app/data,
# gerados na VM pelo pipeline de ingestão: a imagem não depende da versão do dado.
ARG CACHEBUST=1
RUN echo "Building version: $CACHEBUST"
COPY src/ src/
COPY scripts/ scripts/

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Porta do serviço FastAPI
EXPOSE 8000

# Execução do microsserviço Roteador
CMD ["uvicorn", "src.services.router_service:app", "--host", "0.0.0.0", "--port", "8000"]
