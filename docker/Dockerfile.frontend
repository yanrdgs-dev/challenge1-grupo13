# Frontend (Vite/React): build estático servido por nginx, com proxy de /api para o router.
# Estágio 1: testa e compila. O `npm run build` roda `tsc -b`, então um erro de tipo reprova a imagem no CI.
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# Testes da lógica pura (página /status) antes de compilar: falha de teste também reprova a imagem no CI.
RUN npm test
RUN npm run build

# Estágio 2: só o resultado estático e a configuração do nginx (sem Node nem node_modules).
FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.frontend.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
# Passa por nginx + proxy + router: prova o caminho inteiro, não só o servidor estático.
HEALTHCHECK --interval=15s --timeout=5s --retries=5 --start-period=10s \
  CMD wget -qO- http://127.0.0.1/api/health > /dev/null || exit 1
